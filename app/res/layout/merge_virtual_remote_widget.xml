<?xml version="1.0" encoding="utf-8"?>
<!-- Weighted rows so the remote fills any widget size. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonHelp"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark"
            android:text="Help" />

        <Button
            android:id="@+id/Button1"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="1" />

        <Button
            android:id="@+id/Button2"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="2" />

        <Button
            android:id="@+id/Button3"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="3" />

        <Button
            android:id="@+id/ButtonPower"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_red"
            android:text="PWR" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/Button4"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="4" />

        <Button
            android:id="@+id/Button5"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="5" />

        <Button
            android:id="@+id/Button6"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="6" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonVolP"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_light"
            android:text="V+" />

        <Button
            android:id="@+id/Button7"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="7" />

        <Button
            android:id="@+id/Button8"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="8" />

        <Button
            android:id="@+id/Button9"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="9" />

        <Button
            android:id="@+id/ButtonBouP"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_light"
            android:text="B+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonVolM"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_light"
            android:text="V-" />

        <Button
            android:id="@+id/ButtonLeftArrow"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="&lt;" />

        <Button
            android:id="@+id/Button0"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="0" />

        <Button
            android:id="@+id/ButtonRightArrow"
            style="@style/WidgetRemoteButton.Medium"
            android:background="@drawable/button_key_dark"
            android:text="&gt;" />

        <Button
            android:id="@+id/ButtonBouM"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_light"
            android:text="B-" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonRed"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_red" />

        <Button
            android:id="@+id/ButtonGreen"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_green" />

        <Button
            android:id="@+id/ButtonYellow"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_yellow" />

        <Button
            android:id="@+id/ButtonBlue"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_blue" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonInfo"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark"
            android:text="Info" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/ButtonUp"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_light"
            android:contentDescription="Up"
            android:src="@drawable/ic_key_up" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/ButtonMenu"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark"
            android:text="Menu" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/ButtonLeft"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_light"
            android:contentDescription="Left"
            android:src="@drawable/ic_key_left" />

        <Button
            android:id="@+id/ButtonOk"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_light"
            android:text="OK" />

        <ImageButton
            android:id="@+id/ButtonRight"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_light"
            android:contentDescription="Right"
            android:src="@drawable/ic_key_right" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonAudio"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark"
            android:text="Audio" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/ButtonDown"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_light"
            android:contentDescription="Down"
            android:src="@drawable/ic_key_down" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/ButtonPvr"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark"
            android:text="PVR" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5" />

        <Button
            android:id="@+id/ButtonMute"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark"
            android:text="Mute" />

        <Button
            android:id="@+id/ButtonExit"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_red"
            android:text="Exit" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/ButtonRwd"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_dark_oval"
            android:contentDescription="Rewind"
            android:src="@drawable/ic_media_previous_dark" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/ButtonPlay"
                style="@style/WidgetRemoteImageButton"
                android:layout_width="match_parent"
                android:background="@drawable/button_key_dark_oval"
                android:contentDescription="Play"
                android:src="@drawable/ic_media_play_dark" />

            <ImageButton
                android:id="@+id/ButtonPlayPause"
                style="@style/WidgetRemoteImageButton"
                android:layout_width="match_parent"
                android:background="@drawable/button_key_dark_oval"
                android:contentDescription="Play/Pause"
                android:src="@drawable/ic_media_play_pause_dark" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/ButtonStop"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_dark_oval"
            android:contentDescription="Stop"
            android:src="@drawable/ic_media_stop_dark" />

        <ImageButton
            android:id="@+id/ButtonFwd"
            style="@style/WidgetRemoteImageButton"
            android:background="@drawable/button_key_dark_oval"
            android:contentDescription="Fast forward"
            android:src="@drawable/ic_media_next_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button
            android:id="@+id/ButtonTv"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark_oval"
            android:text="TV" />

        <Button
            android:id="@+id/ButtonRadio"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark_oval"
            android:text="RADIO" />

        <Button
            android:id="@+id/ButtonText"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark_oval"
            android:text="TEXT" />

        <Button
            android:id="@+id/ButtonRec"
            style="@style/WidgetRemoteButton"
            android:background="@drawable/button_key_dark_oval"
            android:text="REC" />
    </LinearLayout>

</merge>
