<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Do not redefine Theme.DreamDroid here. `television` beats `night`, so a
         Leanback (or even a fixed Light) parent would freeze TV and ignore the
         phone light/night/dynamic themes. -->

    <style name="Theme.DreamDroid.Dialog" parent="Theme.DreamDroid">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <style name="Theme.DreamDroid.Dialog.Alert" parent="Theme.DreamDroid.Dialog" />
    <style name="Theme.Dreamdroid.FullscreenDialog" parent="Theme.DreamDroid.Dialog" />
</resources>
