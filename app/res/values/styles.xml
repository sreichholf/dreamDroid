<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="CardListView">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">6dp</item>
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="CardListView.Light" parent="CardListView" />

    <style name="RemoteButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@animator/button_elevation</item>
    </style>

    <style name="RemoteButton.Big" parent="RemoteButton">
        <item name="android:layout_margin">5dp</item>
    </style>

    <style name="RemoteButton.Medium" parent="RemoteButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Medium</item>
    </style>

    <style name="FloatingActionButton.Primary" parent="Widget.Material3.FloatingActionButton.Primary" />

    <style name="ExtendedFloatingActionButton.Primary"
        parent="Widget.Material3.ExtendedFloatingActionButton.Primary" />

    <style name="ShapeAppearance.DreamDroid.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.DreamDroid.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.DreamDroid.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.DreamDroid.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:drawableTint">?attr/colorOnSurface</item>
        <item name="drawableTint">?attr/colorOnSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.DreamDroid.ActionButton.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>

    <!-- MenuProvider inflates via the Activity; setIcon() also reloads white
         vectors. This overlay tints ActionMenuItemView compound drawables. -->
    <style name="ThemeOverlay.DreamDroid.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="actionButtonStyle">@style/Widget.DreamDroid.ActionButton</item>
        <item name="actionOverflowButtonStyle">@style/Widget.DreamDroid.ActionButton.Overflow</item>
    </style>

    <style name="ActionModeStyle" parent="@style/Widget.Material3.ActionMode">
        <item name="background">?attr/colorSurfaceContainerHigh</item>
    </style>
</resources>
