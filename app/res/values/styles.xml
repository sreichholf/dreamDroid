<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="CardText">
        <item name="android:textSize">14sp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/text_color</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="CardTitle" parent="@style/CardText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/title_color</item>
    </style>

    <style name="CardTextSmall" parent="@style/CardText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/text_color</item>
    </style>

    <style name="CardListView">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">6dp</item>
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="CardListView.Light" parent="CardListView" />

    <style name="SimpleHeaderSmall" parent="@style/TextAppearance.Material3.TitleSmall">
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SimpleHeaderMedium" parent="@style/TextAppearance.Material3.TitleMedium">
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ButtonPanel" />

    <style name="NavButtonBar" parent="@style/Widget.AppCompat.ButtonBar" />

    <style name="NavButtonBarButton">
        <item name="android:background">?attr/listItemBackground</item>
    </style>

    <style name="RemoteButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@animator/button_elevation</item>
    </style>

    <style name="RemoteButton.Big" parent="RemoteButton">
        <item name="android:layout_margin">5dp</item>
    </style>


    <style name="RemoteButton.Medium" parent="RemoteButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Medium</item>
    </style>

    <style name="NavigationView">
        <item name="android:background">?android:windowBackground</item>
        <item name="itemShapeFillColor">@color/mtrl_navigation_item_background_color</item>
    </style>

    <style name="MediumHeader" parent="SimpleHeaderSmall">
        <item name="android:textAppearance">@android:style/TextAppearance.Medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SelectableItem">
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="mdtp_ActionButton" parent="Widget.Material3.Button.TextButton.Dialog.Flush" />

    <style name="Button" parent="Widget.Material3.Button" />

    <style name="FloatingActionButton.Primary" parent="Widget.Material3.FloatingActionButton.Primary" />

    <style name="ExtendedFloatingActionButton.Primary"
        parent="Widget.Material3.ExtendedFloatingActionButton.Primary" />

    <style name="Drawer" parent="Widget.Material3.FloatingActionButton.Primary" />

    <style name="Preference_TextAppearanceMaterialBody2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="ShapeAppearance.DreamDroid.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.DreamDroid.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.DreamDroid.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ToolbarStyle" parent="@style/Widget.Material3.Toolbar.OnSurface">
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <!-- MenuProvider inflates via the Activity, not Toolbar.inflateMenu(), so
             materialThemeOverlay alone does not tint action items. android:theme
             wraps the ActionMenuView; iconTint covers MaterialToolbar's own path. -->
        <item name="android:theme">@style/ThemeOverlay.Material3.Toolbar.Surface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="ActionModeStyle" parent="@style/Widget.Material3.ActionMode">
        <item name="background">?attr/colorSurfaceContainerHigh</item>
    </style>
</resources>
